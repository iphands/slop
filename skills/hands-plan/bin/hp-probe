#!/usr/bin/env bash
# hp-probe — check reference/sections.md probe phrases against one section of a file. Read-only.
#
# Usage:
#   hp-probe <file> [--section <hp-id> | --heading <ERE> | --lines <A>-<B>] -- <probe> [<probe> …]
#
#   --section <id>   the section whose heading carries <!-- hp:<id> --> (stamped files)
#   --heading <ERE>  the first markdown heading matching ERE, case-insensitive (legacy files)
#   --lines A-B      an explicit line range
#   (none)           the whole file
#
# A section runs from its heading to the next heading of the same or a higher level.
# Matching is case-insensitive on normalized text: `*`, `_` emphasis markers and backticks are
# removed and all whitespace (including line breaks) collapses to one space — so a phrase that
# wraps across lines or carries **bold** still matches. A probe may list alternatives
# separated by "||"; it is a HIT if any alternative matches.
#
# Output, one line per probe:  HIT|MISS <TAB> <probe> <TAB> <section-range>

set -uo pipefail
export LC_ALL=C

[ $# -ge 1 ] || { sed -n '2,20p' "$0"; exit 2; }
f=$1; shift
[ -f "$f" ] || { echo "hp-probe: no such file: $f" >&2; exit 2; }
mode=all; arg=
while [ $# -gt 0 ] && [ "$1" != -- ]; do
    case "$1" in
        --section) mode=section; arg=$2; shift 2;;
        --heading) mode=heading; arg=$2; shift 2;;
        --lines)   mode=lines;   arg=$2; shift 2;;
        *) echo "hp-probe: unknown option $1" >&2; exit 2;;
    esac
done
[ "${1:-}" = -- ] && shift
[ $# -ge 1 ] || { echo "hp-probe: no probes given" >&2; exit 2; }

# locate the section: print "A B"
range=$(awk -v mode="$mode" -v arg="$arg" '
    function level(s) { match(s, /^#+/); return RLENGTH }
    { line[NR] = $0 }
    END {
        a = 1; b = NR
        if (mode == "lines") { split(arg, r, "-"); a = r[1] + 0; b = r[2] + 0; if (b > NR) b = NR }
        else if (mode == "section" || mode == "heading") {
            a = 0
            for (i = 1; i <= NR; i++) {
                if (line[i] !~ /^#+[[:space:]]/) continue
                if (mode == "section" && index(line[i], "<!-- hp:" arg " -->")) { a = i; break }
                if (mode == "heading" && tolower(line[i]) ~ tolower(arg)) { a = i; break }
            }
            if (!a) { print "0 0"; exit }
            lv = level(line[a]); b = NR; fence = 0
            for (i = a + 1; i <= NR; i++) {
                if (line[i] ~ /^```/) fence = !fence
                if (!fence && line[i] ~ /^#+[[:space:]]/ && level(line[i]) <= lv) { b = i - 1; break }
            }
        }
        print a, b
    }' "$f")
read -r A B <<< "$range"

norm() { tr -d '*`' | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' ' '; }
if [ "$A" -eq 0 ]; then
    for p in "$@"; do printf 'MISS\t%s\tsection-not-found\n' "$p"; done
    exit 1
fi
text=$(sed -n "${A},${B}p" "$f" | norm)
miss=0
for p in "$@"; do
    hit=n
    IFS=$'\n' read -r -d '' -a alts < <(printf '%s' "$p" | sed 's/||/\n/g'; printf '\0')
    for alt in "${alts[@]}"; do
        q=$(printf '%s' "$alt" | norm | sed 's/^ //; s/ $//')
        [ -n "$q" ] && [[ $text == *"$q"* ]] && { hit=y; break; }
    done
    if [ "$hit" = y ]; then printf 'HIT\t%s\t%s-%s\n' "$p" "$A" "$B"
    else printf 'MISS\t%s\t%s-%s\n' "$p" "$A" "$B"; miss=$((miss + 1)); fi
done
[ "$miss" -eq 0 ]
