#!/usr/bin/env bash
# hp-probe — check reference/sections.md probe phrases against one section of a file. Read-only.
#
# Usage:
#   hp-probe <file> [--section <hp-id> | --heading <ERE> | --lines <A>-<B>] -- <probe> [<probe> …]
#   hp-probe <file> --toc          list the real markdown headings (line, level, text) — fenced
#                                  code is skipped, so `# comment` lines in code blocks don't show
#
#   --section <id>   the section whose heading carries <!-- hp:<id> --> (stamped files)
#   --heading <ERE>  the first markdown heading matching ERE, case-insensitive (legacy files)
#   --lines A-B      an explicit line range
#   (none)           the whole file
#
# A section runs from its heading to the next heading of the same or a higher level. Headings
# inside fenced code blocks are ignored; fences follow CommonMark (a ``` or ~~~ fence closes
# only on the same character, at least as long as the opener), so nested fences are safe.
# Matching is case-insensitive on normalized text: `*` and backticks are removed and all
# whitespace (including line breaks) collapses to one space — so a phrase that wraps across
# lines or carries **bold** still matches. (`_` is kept: probes such as `_RULES.md` need it.)
# A probe may list alternatives separated by "||"; it is a HIT if any alternative matches.
#
# Output, one line per probe:  HIT|MISS <TAB> <probe> <TAB> <section-range>

set -uo pipefail
export LC_ALL=C

[ $# -ge 1 ] || { sed -n '2,23p' "$0"; exit 2; }
f=$1; shift
[ -f "$f" ] || { echo "hp-probe: no such file: $f" >&2; exit 2; }
mode=all; arg=
while [ $# -gt 0 ] && [ "$1" != -- ]; do
    case "$1" in
        --section) mode=section; arg=$2; shift 2;;
        --heading) mode=heading; arg=$2; shift 2;;
        --lines)   mode=lines;   arg=$2; shift 2;;
        --toc)     mode=toc; shift;;
        *) echo "hp-probe: unknown option $1" >&2; exit 2;;
    esac
done
[ "${1:-}" = -- ] && shift

# Mark every line that is a real heading (outside fenced code): prints "<lineno> <level>".
headings() {
    awk '
    {
        if (fch == "") {
            if (match($0, /^ {0,3}(```+|~~~+)/)) {
                m = substr($0, RSTART, RLENGTH); sub(/^ +/, "", m)
                fch = substr(m, 1, 1); flen = length(m); next
            }
            if ($0 ~ /^#+[[:space:]]/) { match($0, /^#+/); print NR, RLENGTH }
        } else if (match($0, /^ {0,3}(```+|~~~+)[[:space:]]*$/)) {
            m = $0; gsub(/[[:space:]]/, "", m)
            if (substr(m, 1, 1) == fch && length(m) >= flen) fch = ""
        }
    }' "$f"
}

if [ "$mode" = toc ]; then
    headings | while read -r ln lv; do printf '%s\t%s\t%s\n' "$ln" "$lv" "$(sed -n "${ln}p" "$f")"; done
    exit 0
fi
[ $# -ge 1 ] || { echo "hp-probe: no probes given" >&2; exit 2; }

# locate the section: "A B"
total=$(wc -l < "$f")
case "$mode" in
    all) A=1; B=$total;;
    lines) A=${arg%-*}; B=${arg#*-}; [ "$B" -gt "$total" ] && B=$total;;
    *)
        A=0; B=$total; lv=0
        while read -r ln l; do
            if [ "$A" -eq 0 ]; then
                line=$(sed -n "${ln}p" "$f")
                if [ "$mode" = section ]; then
                    [[ $line == *"<!-- hp:$arg -->"* ]] && { A=$ln; lv=$l; }
                else
                    printf '%s\n' "$line" | grep -qiE -- "$arg" && { A=$ln; lv=$l; }
                fi
            elif [ "$l" -le "$lv" ]; then
                B=$((ln - 1)); break
            fi
        done < <(headings)
        ;;
esac

norm() { tr -d '*`' | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' ' '; }
if [ "$A" -eq 0 ]; then
    for p in "$@"; do printf 'MISS\t%s\tsection-not-found\n' "$p"; done
    exit 1
fi
text=$(sed -n "${A},${B}p" "$f" | norm)
miss=0
for p in "$@"; do
    hit=n
    IFS=$'\n' read -r -d '' -a alts < <(printf '%s' "$p" | sed 's/||/\n/g'; printf '\0')
    for alt in "${alts[@]}"; do
        q=$(printf '%s' "$alt" | norm | sed 's/^ //; s/ $//')
        [ -n "$q" ] && [[ $text == *"$q"* ]] && { hit=y; break; }
    done
    if [ "$hit" = y ]; then printf 'HIT\t%s\t%s-%s\n' "$p" "$A" "$B"
    else printf 'MISS\t%s\t%s-%s\n' "$p" "$A" "$B"; miss=$((miss + 1)); fi
done
[ "$miss" -eq 0 ]
