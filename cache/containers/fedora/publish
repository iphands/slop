#!/bin/bash
set -euo pipefail

# Push the built Fedora client image to Docker Hub. THE HUMAN RUNS THIS.
#
#     ./publish
#
# Pushes the moving tag (iphands/pkgcache-fedora:latest) plus every other local
# tag on that image -- the release tag (:44) and the per-commit tag (:<git-sha>).
#
# Arch-suffixed tags from ./build (:latest-arm64, :44-arm64, :<sha>-arm64) are
# pushed alongside, and never collide with the unsuffixed x86_64 tags.
#
# Prereqs: ./build has been run, and you are logged in
#   (`docker login`  or  `podman login docker.io`).
#
# Auto-detects the container engine and PREFERS podman when both are present.
# Force one with  RUNTIME=docker ./publish  (or RUNTIME=podman).

cd "$(dirname "$0")"

# Container engine: honor RUNTIME override, else prefer podman, then docker.
CE="${RUNTIME:-}"
if [ -z "$CE" ]; then
    if command -v podman >/dev/null 2>&1; then CE=podman
    elif command -v docker >/dev/null 2>&1; then CE=docker
    else echo "error: neither podman nor docker found on PATH" >&2; exit 1; fi
fi
command -v "$CE" >/dev/null 2>&1 || { echo "error: RUNTIME=$CE not found on PATH" >&2; exit 1; }

IMAGE="${IMAGE:-iphands/pkgcache-fedora}"

if [ -z "$("$CE" images -q "${IMAGE}" 2>/dev/null)" ]; then
    echo "nothing built to publish for ${IMAGE} -- run ./build first" >&2
    exit 1
fi

echo ">> [$CE] pushing ${IMAGE}:latest and any other ${IMAGE}:<tag>"
# podman reports local images as localhost/<name> (and docker.io/<name> for pulled
# ones); docker reports bare <name>. Match all three, then push by the short name.
"$CE" images --format '{{.Repository}} {{.Tag}}' \
    | awk -v img="$IMAGE" '($1==img || $1=="localhost/"img || $1=="docker.io/"img) && $2!="<none>" {print $2}' \
    | sort -u \
    | while read -r tag; do
        echo "   push ${IMAGE}:${tag}"
        "$CE" push "${IMAGE}:${tag}"
    done
